<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mycelium.healthcheck.hourly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /ABS/PATH/TO/mycelium &amp;&amp; ./scripts/healthcheck_server.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>MYCELIUM_SERVER_URL</key>
    <string>http://127.0.0.1:8080</string>
  </dict>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/mycelium/healthcheck.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/mycelium/healthcheck.log</string>
</dict>
</plist>
