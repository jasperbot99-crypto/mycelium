# Database
DATABASE_URL=postgresql://localhost:5432/mycelium_dev
TEST_DATABASE_URL=postgresql://localhost:5432/mycelium_test

# Embeddings (OpenAI text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Optional: LLM for enrichment operations (not needed for core)
ANTHROPIC_API_KEY=sk-ant-...

# Conflict resolution LLM provider (Phase 4)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...

# Server mode (Phase 5)
MYCELIUM_SERVER_HOST=127.0.0.1
MYCELIUM_SERVER_PORT=8080
MYCELIUM_SERVER_API_KEY=change-me
MYCELIUM_SERVER_REQUEST_TIMEOUT_S=30
MYCELIUM_SERVER_CORS_ORIGINS=
